DEBUG=True
SECRET_KEY=django-insecure-change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1
# Full origins with scheme (Django 4+ CSRF Origin check). Example for prod:
# CSRF_TRUSTED_ORIGINS=https://sp.devel.b6a.pl
CSRF_TRUSTED_ORIGINS=

DATABASE_URL=postgres://sp_admin:password@127.0.0.1:5433/solutionpositive

# Lokalny Postfix (relay bez logowania) — port 25, bez STARTTLS.
# NIE używaj 587/submission z EMAIL_USE_TLS=True (błąd bad certificate).
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=127.0.0.1
EMAIL_PORT=25
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@selectio.local
