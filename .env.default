DEBUG=True
SECRET_KEY=django-insecure-change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1
# Full origins with scheme (Django 4+ CSRF Origin check). Example for prod:
# CSRF_TRUSTED_ORIGINS=https://sp.devel.b6a.pl
CSRF_TRUSTED_ORIGINS=

DATABASE_URL=postgres://sp_admin:password@127.0.0.1:5433/solutionpositive

# Lokalny Postfix: STARTTLS wymagane, cert często self-signed.
EMAIL_BACKEND=users.mail.EmailBackend
EMAIL_HOST=127.0.0.1
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_SSL_VERIFY=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Adres FROM musi mieć domenę znaną Postfixowi (nie *.local).
DEFAULT_FROM_EMAIL=noreply@sp.devel.b6a.pl
SERVER_EMAIL=noreply@sp.devel.b6a.pl
